

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//Manual del usuario
//Pruebas
//

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String
  password          String
  type              Boolean
  locals            Local[]
  localFavorites    LocalFavorites[]
  productFavorites  ProductFavorites[]
  Reservations      Reservations?
}

model LocalFavorites {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique  
  local     Local    @relation(fields: [localId], references: [id])
  localId   String   
  dateFrom  DateTime @map("date_from")
  dateTo    DateTime @map("date_to")
}

model ProductFavorites {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  dateFrom  DateTime @map("date_from")
  dateTo    DateTime @map("date_to")
}

model Reservations {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id])
  userId    String        @unique
  service   LocalService  @relation(fields: [serviceId], references: [id])
  serviceId String
  dateTime  DateTime      @map("date_time")
  comment   String
}

model Local {
  id                String   @id @default(cuid())
  name              String   @unique
  location          String //Consider changing to REAL
  whatsapp          Int      @unique
  instagram         String?
  facebook          String?
  webpage           String?
  image             String?
  dateFrom          DateTime @map("date_from")
  dateTo            DateTime @map("date_to")
  users             User[]
  hours             LocalHours? //Primsa forces you to make them nullable  
  localFavorites    LocalFavorites[]
  services          LocalService[]
  localTypes        LocalTypes @relation(fields: [localTypeID], references: [id])
  localTypeID       String 
  product           LocalProduct[]
  localDiscountDeal LocalDiscountDeal[]
  viewLocal         ViewLocal[]
}

model LocalProduct {
  id        String   @id @default(cuid())
  local     Local    @relation(fields: [localId], references: [id])
  localId   String   @unique
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @unique
  dateFrom  DateTime @map("date_from")
  dateTo    DateTime @map("date_to")
} 

model LocalHours {
  id         String @id @default(cuid())
  local      Local  @relation(fields: [localId], references: [id])
  localId    String @unique
  dayNumber  Int    @map("day_number")
  AMHourFrom String @map("am_hour_from")
  AMHourTo   String @map("am_hour_to")
  PMHourFrom String @map("pm_hour_from")
  PMHourTo   String @map("pm_hour_to")
  EXHourFrom String @map("ex_hour_from")
  EXHourTo   String @map("ex_hour_to")
}

model LocalTypes {
  id        String @id @default(cuid())
  name      String
  locals    Local[]
}

model LocalDiscountDeal {
  id           String @id @default(cuid())
  local        Local @relation(fields: [localId], references: [id])
  localId      String
  dealDiscount String @map("deal_discount")
  dateFrom     DateTime @map("date_from")
  dateTo       DateTime @map("date_to")
  active       Boolean
}

model ViewLocal {
  id      String  @id @default(cuid())
  local   Local   @relation(fields: [localId], references: [id])
  localId String
}

model Product {
  id               String              @id @default(cuid())
  name             String          
  updatedAt        DateTime            @updatedAt
  brand            String          
  mesurement       String          
  imgURL           String              @map("img_url")
  price            Float?
  description      String
  productFavorites ProductFavorites[]
  local            LocalProduct[]
  type             ProductType         @relation(fields: [productTypeId], references: [id])
  productDiscountDeal ProductDiscountDeal[]
  productTypeId    String            
}

model ProductType {
  id      String @id @default(cuid())
  name    String
  product Product[]
}

model ProductDiscountDeal {
  id           String  @id @default(cuid())
  product      Product @relation(fields: [productId], references: [id])
  productId    String
  dealDiscount String @map("deal_discount")
  dateFrom     DateTime @map("date_from")
  dateTo       DateTime @map("date_to")
  active       Boolean
}

model LocalService {
  id            String    @id @default(cuid())
  name          String
  local         Local     @relation(fields: [localId], references: [id])
  localId       String    @unique
  service       Service   @relation(fields: [serviceId], references: [id])
  serviceId     String    @unique
  dateFrom      DateTime  @map("date_from")
  dateTo        DateTime  @map("date_to")
  AMHourFrom    String    @map("am_hour_from")
  AMHourTo      String    @map("am_hour_to")
  PMHourFrom    String    @map("pm_hour_from")
  PMHourTo      String    @map("pm_hour_to")
  EXHourFrom    String    @map("ex_hour_from")
  EXHourTo      String    @map("ex_hour_to")
  Reservations  Reservations[] 
}

model Service {
  id            String          @id @default(cuid())
  localService  LocalService[]
  reservtionURL String          @map("reservation_url")
  description   String
}




